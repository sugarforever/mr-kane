{
	"name": "mr-kane",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 127.0.0.1",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"start": "node --env-file-if-exists=.env scripts/start.mjs",
		"test:smoke:recordings": "npm run build && node scripts/smoke-recordings.mjs",
		"test:smoke:ai": "npm run build && node scripts/smoke-ai.mjs"
	},
	"dependencies": {
		"@earendil-works/chord": "^1.5.2",
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-durable": "^1.5.2",
		"@lucide/svelte": "^1.73.0",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@sveltejs/adapter-node": "6.0.2",
		"@sveltejs/kit": "3.2.0",
		"@tailwindcss/vite": "^4.3.5",
		"bits-ui": "^2.21.0",
		"cn": "^0.5.2",
		"svelte": "^5.57.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.1.0"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "^24.0.0",
		"fake-indexeddb": "^6.2.8",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	},
	"imports": {
		"#lib/*.svelte": "./src/lib/*.svelte",
		"#lib/*": "./src/lib/*.ts"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
