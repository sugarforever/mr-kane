# Optional one-time bootstrap for a NEW data directory. Prefer AI Providers in the app.
PI_PROVIDER=anthropic
PI_MODEL=claude-sonnet-4-5
PI_API_KEY=

# Dedicated private directory for settings, credentials and durable AI requests.
# MR_KANE_DATA_DIR=./data

# Optional: OpenAI audio transcription; separate from ChatGPT subscription OAuth.
# OPENAI_API_KEY=

# Adapter-node request limit for optional audio checks (route accepts up to 20 MB).
BODY_SIZE_LIMIT=21M

# Optional fallback for MiniMax speech; saved Speech settings keys take priority.
# MINIMAX_API_KEY=
